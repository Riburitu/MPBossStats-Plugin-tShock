<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>MPBossStats</AssemblyName>
    <RootNamespace>MPBossStats</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <TShockDir>References</TShockDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TShockAPI"><HintPath>$(TShockDir)\TShockAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OTAPI"><HintPath>$(TShockDir)\OTAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TerrariaServer" Condition="Exists('$(TShockDir)\TerrariaServer.dll')"><HintPath>$(TShockDir)\TerrariaServer.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ModFramework" Condition="Exists('$(TShockDir)\ModFramework.dll')"><HintPath>$(TShockDir)\ModFramework.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
